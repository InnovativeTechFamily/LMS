# MongoDB
MONGODB_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/LMS
MONGODB_DATABASE_NAME=LMS

# JWT
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret-key-minimum-32-characters-long
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-minimum-32-characters-long
JWT_ACTIVATION_TOKEN_SECRET=your-activation-token-secret-key-minimum-32-characters-long
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=3

# Redis
REDIS_CONNECTION_STRING=localhost:6379
REDIS_CACHE_EXPIRATION_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email
SENDGRID_KEY=SG.your-sendgrid-key
EMAIL_FROM=noreply@lms.com
EMAIL_FROM_NAME=LMS Platform

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://lms-ivory-one.vercel.app

# Application
APP_ENV=development
PORT=8000
