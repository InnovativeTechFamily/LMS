{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb+srv://username:password@cluster.mongodb.net",
    "DatabaseName": "LMS"
  },
  "Jwt": {
    "AccessTokenSecret": "your-access-token-secret-key-minimum-32-characters-long",
    "RefreshTokenSecret": "your-refresh-token-secret-key-minimum-32-characters-long",
    "ActivationTokenSecret": "your-activation-token-secret-key-minimum-32-characters-long",
    "AccessTokenExpirationMinutes": 5,
    "RefreshTokenExpirationDays": 3
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "CacheExpirationDays": 7
  },
  "Cloudinary": {
    "CloudName": "your-cloud-name",
    "ApiKey": "your-api-key",
    "ApiSecret": "your-api-secret"
  },
  "Stripe": {
    "SecretKey": "sk_test_your-stripe-secret-key",
    "PublishableKey": "pk_test_your-stripe-publishable-key",
    "WebhookSecret": "whsec_your-webhook-secret"
  },
  "Email": {
    "SendGridKey": "SG.your-sendgrid-key",
    "FromEmail": "noreply@lms.com",
    "FromName": "LMS Platform"
  },
  "RateLimit": {
    "WindowMs": 900000,
    "MaxRequests": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://lms-ivory-one.vercel.app"
    ]
  }
}
