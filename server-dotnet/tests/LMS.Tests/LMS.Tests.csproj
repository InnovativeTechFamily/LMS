<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The app targets net8.0, but no .NET 8 runtime is installed on this machine (only 9/10).
      The ASP.NET Core 8 TestHost is incompatible with the net10 runtime under roll-forward, so the
      test project targets net9.0 (an installed runtime) with a matching Mvc.Testing. It references
      the net8.0 app projects (down-level references are allowed) and runs them in-process.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LMS.Application\LMS.Application.csproj" />
    <ProjectReference Include="..\..\src\LMS.Infrastructure\LMS.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LMS.WebApi\LMS.WebApi.csproj" />
  </ItemGroup>

</Project>
